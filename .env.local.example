# Supabase — used for data storage only (not auth)
# Get from: supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase — used for authentication (Google OAuth + email/password)
# Get from: console.firebase.google.com → project → Settings → General → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_CLIENT_ID=your-google-oauth-client-id

# OpenRouter — used for AI section generation
# Get from: openrouter.ai → Keys
OPENROUTER_API_KEY=your-openrouter-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin
ADMIN_SEED_EMAIL=pratham.nawal21@gmail.com

# MCP server (/api/mcp) — see docs/mcp/ENGINEERING_PLAN.md
# Required: encrypts saved Figma tokens and signs publish/NDA confirmation tokens. Any long random string.
MCP_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
# Optional: model for labelling, extraction and writing (OpenRouter id). Defaults to Claude Haiku 4.5.
MCP_MODEL=
# Optional: fallback Figma token used when a user hasn't connected their own.
FIGMA_ACCESS_TOKEN=
# Optional: AI credits charged per build_case_study run for free-plan users (default 3).
MCP_BUILD_CREDIT_COST=3
